# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=your-random-session-secret

# Wikimedia OAuth 2.0 (Optional in local dev; required for direct Wikipedia publishing)
# Register your OAuth consumer at https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration
# You can use either WIKI_CLIENT_* or OAUTH_CONSUMER_* variable names:
WIKI_CLIENT_ID=
WIKI_CLIENT_SECRET=
WIKI_CALLBACK_URL=https://source-translation.toolforge.org/callback

# Aliases (also supported):
OAUTH_CONSUMER_KEY=
OAUTH_CONSUMER_SECRET=
OAUTH_CALLBACK_URL=http://localhost:8000/callback

# Phase 1 Verified Users Whitelist (Comma-separated Wikipedia usernames allowed to publish to Mainspace)
VERIFIED_MAINSPACE_USERS=YourUsername,AnotherUsername
